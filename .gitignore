# Never commit credentials or runtime state
wp-config.php
.env
.env.*
*.log
error_log
error_log.*
debug.log

# Host / upgrade artefacts
.htaccess.phpupgrader.*
.htaccess.no_htaccess.*

# Archives and database dumps
*.rar
*.zip
*.tar
*.tar.gz
*.bak
*.sql

# Uploads are site content, not source
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/

# Added 2026-11-05 before making the repo public: logs, dumps and env files never get committed
wp-content/uploads/wc-logs/
*.sql.gz
*.wpress
wp-content/ai1wm-backups/
